# -----------------------------------------------------------------------------
# ARB News — live news / CMS API keys
# Copy to .env.local and fill in at least one key.
# Without keys, the app serves sample articles (safe for CI / local demo).
# -----------------------------------------------------------------------------

# NewsAPI.org — https://newsapi.org/register (free developer plan)
NEWS_API_KEY=

# Optional: GNews.io — https://gnews.io/ (used if NewsAPI fails or as primary)
GNEWS_API_KEY=

# Which provider to try first: auto | newsapi | gnews
# auto = try NewsAPI then GNews when keys are present
NEWS_PROVIDER=auto
