# -----------------------------------------------------------------------------
# ARB News — environment variables
# Copy to .env.local for local dev. Never commit real keys.
# On Vercel: Project → Settings → Environment Variables
# -----------------------------------------------------------------------------

# Public site URL (used for sitemap, robots, canonical, Open Graph)
# Production example: https://arb-news-next.vercel.app
NEXT_PUBLIC_SITE_URL=

# NewsAPI.org — https://newsapi.org/register
NEWS_API_KEY=

# GNews.io — https://gnews.io/dashboard
GNEWS_API_KEY=

# Which provider to try first: auto | newsapi | gnews
# auto = try NewsAPI then GNews when keys are present
NEWS_PROVIDER=auto

# Security
# - Do not paste API keys into chat, commits, or screenshots
# - If a key was exposed, rotate it in the provider dashboard immediately
